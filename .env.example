# ==============================================================================
# Vocabulario — szablon zmiennych środowiskowych (BACKEND / FastAPI)
# ------------------------------------------------------------------------------
# Skopiuj ten plik do `.env` i uzupełnij wartości:   cp .env.example .env
# `.env` jest w .gitignore — NIGDY nie commituj prawdziwych sekretów.
#
# Legenda:
#   [TY]        = wartość dostarczasz Ty (klucz, dane konta)
#   [JA]        = generuję/ustawiam ja lub jest domyślne
#   [RAILWAY]   = w produkcji Railway wstawi automatycznie (z pluginów)
# ==============================================================================

# --- Środowisko / aplikacja -------------------------------------------------
ENVIRONMENT=development            # development | staging | production   [JA]
APP_NAME=vocabulario               # nazwa techniczna                      [JA]
API_V1_PREFIX=/api/v1              # prefix API                            [JA]
LOG_LEVEL=INFO                     # DEBUG | INFO | WARNING | ERROR        [JA]

# --- Baza danych (PostgreSQL) -----------------------------------------------
# Lokalnie (docker-compose) używamy wartości poniżej.
# Na Railway zmienną DATABASE_URL wstawia plugin Postgres.               [RAILWAY]
DATABASE_URL=postgresql+asyncpg://vocab:vocab@localhost:5432/vocabulario

# --- Redis (cache + kolejki zadań) ------------------------------------------
# Lokalnie z docker-compose. Na Railway wstawia plugin Redis.            [RAILWAY]
REDIS_URL=redis://localhost:6379/0

# --- Bezpieczeństwo / JWT ---------------------------------------------------
JWT_SECRET=CHANGE_ME_generate_a_long_random_string   # [JA generuję losowo]
JWT_ACCESS_TTL_MIN=30              # ważność access tokena (minuty)        [JA]
JWT_REFRESH_TTL_DAYS=30            # ważność refresh tokena (dni)          [JA]

# --- AI / LLM ---------------------------------------------------------------
LLM_PROVIDER=openai                # openai | anthropic                    [JA/TY]

# Tryb mock: gdy true, backend NIE woła prawdziwego API (deterministyczne
# odpowiedzi do developmentu/testów). Ustaw false, by użyć realnego klucza.
AI_MOCK=true                       # true na dev bez kosztów; false na realne [JA]

# Klucz OpenAI — WKLEJ w Railway (secret), nie do repo.                   [TY]
OPENAI_API_KEY=

# Modele (do doprecyzowania po teście jakości PL<->ES):
OPENAI_MODEL_LOOKUP=gpt-5.4-mini       # tani/szybki do listy kandydatów  [JA]
OPENAI_MODEL_ENRICHMENT=gpt-5.6-sol    # mocniejszy do pełnej karty       [JA]

# Alternatywny provider (opcjonalnie, jeśli LLM_PROVIDER=anthropic):
ANTHROPIC_API_KEY=                     #                                  [TY opc.]
ANTHROPIC_MODEL_LOOKUP=
ANTHROPIC_MODEL_ENRICHMENT=

# Ograniczenia kosztów/abuse:
AI_LOOKUP_RATE_PER_MIN=20          # limit lookupów na usera / min         [JA]
AI_REQUEST_TIMEOUT_S=20            # timeout wywołania LLM (s)             [JA]

# --- Logowanie Google (opcjonalnie w v0.1) ----------------------------------
# Web client ID służy backendowi do weryfikacji id_token z Androida.
GOOGLE_OAUTH_WEB_CLIENT_ID=            #                                  [TY jeśli Google]
GOOGLE_OAUTH_ANDROID_CLIENT_ID=        #                                  [TY jeśli Google]

# --- CORS / klienci ----------------------------------------------------------
# Lista dozwolonych originów (panel web nauczyciela w v0.3). Rozdziel przecinkami.
ALLOWED_ORIGINS=http://localhost:3000  #                                  [JA]

# --- Monitoring (opcjonalne, zalecane) --------------------------------------
SENTRY_DSN=                            #                                  [TY opc.]

# ==============================================================================
# SEKRETY POZA TYM PLIKIEM (nie backend .env — trafiają w inne miejsca):
# ------------------------------------------------------------------------------
#  GitHub Secrets (CI/CD):
#    RAILWAY_TOKEN                 -> auto-deploy na Railway               [TY]
#    ANDROID_KEYSTORE_BASE64       -> podpisywanie buildu Androida         [JA generuję / TY trzymasz]
#    ANDROID_KEYSTORE_PASSWORD
#    ANDROID_KEY_ALIAS
#    ANDROID_KEY_PASSWORD
#    PLAY_SERVICE_ACCOUNT_JSON     -> auto-upload do Google Play (opc.)    [TY opc.]
#
#  Android (android/local.properties, NIE commitowane):
#    APP_APPLICATION_ID            -> np. com.stepien.vocabulario          [TY decyzja]
#    API_BASE_URL                  -> URL backendu (Railway) / localhost   [JA]
# ==============================================================================
