# =============================================================================
# Vocabulario — szablon zmiennych środowiskowych
# =============================================================================
# Skopiuj do .env i uzupełnij sekrety:
#   copy .env.example .env   (Windows)
#   cp .env.example .env     (macOS/Linux)
# =============================================================================

# --- Środowisko ---
ENVIRONMENT=development
DEBUG=true
API_HOST=0.0.0.0
API_PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://10.0.2.2:8000

# --- Baza (lokalny PostgreSQL albo docker-compose) ---
POSTGRES_USER=vocabulario
POSTGRES_PASSWORD=vocabulario_dev
POSTGRES_DB=vocabulario
# Lokalny Postgres Windows: 5432 | docker-compose (infra/): 5433
DATABASE_URL=postgresql+asyncpg://vocabulario:vocabulario_dev@localhost:5432/vocabulario

# Publiczny URL produkcyjnego PG (Railway) — do odczytu app_logs, nie do lokalnego API
# PROD_DATABASE_URL=postgresql://postgres:...@....proxy.rlwy.net:PORT/railway

# --- Redis (opcjonalnie; na razie nieużywany przez appkę) ---
REDIS_URL=redis://localhost:6379/0

# --- Auth / JWT ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- LLM (OpenAI) ---
OPENAI_API_KEY=sk-REPLACE_ME
LLM_PROVIDER=openai
LLM_LOOKUP_MODEL=gpt-5.6-terra
LLM_ENRICHMENT_MODEL=gpt-5.6-terra
LLM_LIGHT_MODEL=gpt-5.6-luna
LLM_MOCK=false

LLM_RATE_LIMIT_PER_MINUTE=20
LLM_MAX_RETRIES=2

# --- Google OAuth ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_ID_ANDROID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Monitoring (opcjonalne) ---
SENTRY_DSN=

# --- Feature flags ---
FEATURE_TEACHER=false
FEATURE_SPEECH_MODE=false
FEATURE_CONJUGATION_DRILLS=false
# false = AI działa, ale lexical_entries i learning_cards NIE trafiają do bazy
PERSIST_WORDS=true
